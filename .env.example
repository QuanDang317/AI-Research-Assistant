# Application Config
APP_NAME="AI Research Assistant"
ENVIRONMENT="development"
DEBUG=True

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database
DATABASE_URL=postgresql://user:password123@localhost:5432/research_db

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=papers

# File Storage
UPLOAD_DIR=./data/papers
